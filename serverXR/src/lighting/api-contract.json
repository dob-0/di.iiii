{
  "contract_version": 1,
  "about": "What the desk UI (ui/*.js) needs from whatever serves it. One entry per distinct method+path. Classes: a = must really exist on a node; b = a node may answer statically or refuse ({error:\"not on this node\"}); c = not applicable on a node, 404 with a JSON body. reply = the keys and JSON types the UI reads on success from the full desk. Types: string number boolean array object, or a|b. probe (class a, POST) = the body tests/test-http.js --class a sends; \"$name\" tokens are filled from earlier captures (dotted path into that reply). Entries run in file order.",
  "state_keys": {
    "about": "Keys of GET api/state the UI dereferences without a guard (required) and keys it reads behind a guard such as `S.x && ...` or `|| default` (optional). Measured by reading ui/app.js renderAll and the paint functions it calls.",
    "required": {
      "status": "object",
      "output": "object",
      "fx": "object",
      "chase": "object",
      "fixtures": "array",
      "scenes": "array",
      "groups": "array",
      "lfos": "array",
      "layers": "array",
      "master": "number",
      "blackout": "boolean",
      "raw": "object",
      "profiles": "object"
    },
    "nested_required": {
      "status": {
        "universes": "array",
        "nodes": "array",
        "interfaces": "array",
        "broadcast": "array",
        "packetsSent": "number",
        "lastError": "string|null",
        "serial": "object|null"
      },
      "output": {
        "driver": "string",
        "serialPort": "string",
        "mode": "string",
        "targets": "array",
        "enabled": "boolean"
      },
      "fx": {
        "mode": "string",
        "bpm": "number",
        "depth": "number",
        "enabled": "boolean"
      },
      "chase": {
        "enabled": "boolean",
        "sceneIds": "array",
        "holdMs": "number",
        "fadeMs": "number"
      }
    },
    "optional": {
      "top": [
        "activeScene",
        "looks",
        "sets",
        "audioCfg",
        "audio",
        "caps",
        "show",
        "roleKinds",
        "fxModes",
        "fxSpatial",
        "now",
        "dmx",
        "midi",
        "cues",
        "customProfiles",
        "fanStyles",
        "lfoWaves",
        "audioModes",
        "blackoutBlind"
      ],
      "status": [
        "identifying",
        "extra",
        "listen",
        "lanAllowed",
        "serialPorts",
        "input"
      ],
      "output": [
        "refreshHz",
        "input"
      ],
      "fx": [
        "spatial",
        "exclude"
      ]
    }
  },
  "entries": [
    {
      "method": "GET",
      "path": "api/state",
      "class": "a",
      "reply": {
        "status": "object"
      },
      "note": "full key list under state_keys",
      "check": "state"
    },
