  "node_routes": {
    "about": "The hardware node's own routes that the 'This node' fold (caps.node) calls. Not api/* and not part of the desk's API: the node answers them as its own README documents. kind console = POST with header X-Vizzz-Console: 1 (else 403; GET is 405), numbers in the query string, form body where args says form. kind read = plain GET. A command answers 204; a refusal 400 {error,arg,min,max}. The UI calls them by relative path (status, not /status). lint:api-contract checks every nodeGet/nodePost literal in ui/*.js against this list and the other way round.",
    "header": "X-Vizzz-Console: 1",
    "routes": [
      {
        "method": "GET",
        "path": "/status",
        "kind": "read",
        "what": "live facts: addresses, Wi-Fi state, source mode, live sources, Art-Net address, burn-safe numbers, heap, firmware"
      },
      {
        "method": "GET",
        "path": "/peers",
        "kind": "read",
        "what": "{peers:[{ip,name,mac,uni,age}],count}"
      },
      {
        "method": "GET",
        "path": "/node/manifest",
        "kind": "read",
        "what": "firmware tag when /status has no fw"
      },
      {
        "method": "GET",
        "path": "/wifi/scan",
        "kind": "read",
        "what": "{scanning,networks:[{ssid,rssi,enc}]} (same origin only); scanning:true is asked again on the next tick"
      },
      {
        "method": "POST",
        "path": "/netmode/set",
        "kind": "console",
        "args": "m=0|1|2 (access point + Wi-Fi / Wi-Fi only / access point only), then restart",
        "what": "Wi-Fi mode"
      },
      {
        "method": "POST",
        "path": "/wifi/set",
        "kind": "console",
        "args": "form: ssid=1-32 B, pass=empty or 8-63",
        "what": "join a network"
      },
      {
        "method": "POST",
        "path": "/wifi/forget",
        "kind": "console",
        "args": "-",
        "what": "clear the saved network"
      },
      {
        "method": "POST",
        "path": "/mode/set",
        "kind": "console",
        "args": "m=0|1|2 (web / network / HTP)",
        "what": "source mode"
      },
      {
        "method": "POST",
        "path": "/mode/fallback",
        "kind": "console",
        "args": "en=0|1",
        "what": "fall back to web when the network is quiet"
      },
      {
        "method": "POST",
        "path": "/artnet/set",
        "kind": "console",
        "args": "net=0-127&subnet=0-15&uni=0-15",
        "what": "Art-Net port-address"
      },
      {
        "method": "POST",
        "path": "/artout/peer",
        "kind": "console",
        "args": "ip=a.b.c.d or empty (broadcast)",
        "what": "Art-Net OUT target"
      },
      {
        "method": "POST",
        "path": "/safety/set",
        "kind": "console",
        "args": "burn=0|1",
        "what": "burn-safe"
      },
      {
        "method": "POST",
        "path": "/panic",
        "kind": "console",
        "args": "-",
        "what": "master 0, blackout, FX and cues off, web only, in one call"
      },
      {
        "method": "POST",
        "path": "/announce",
        "kind": "console",
        "args": "-",
        "what": "send a discovery beacon now"
      },
      {
        "method": "POST",
        "path": "/node/set",
        "kind": "console",
        "args": "form: name, ap_ssid, ap_pass=8-63 (optional)",
        "what": "identity"
      },
      {
        "method": "POST",
        "path": "/reboot",
        "kind": "console",
        "args": "-",
        "what": "restart"
      },
      {
        "method": "POST",
        "path": "/factory-reset",
        "kind": "console",
        "args": "-",
        "what": "erase saved settings and restart"
      }
    ]
  }
}
