{
  "$schema": "https://di-studio.xyz/schemas/di-space.space.schema.json",
  "spaceId": "network",
  "label": "network",
  "isPublic": true,
  "minEngine": 6,
  "note": "Everyone who makes di.iiii — all 52, not only the ones with rooms wired up front. Every page in this space is generated from people.json by build.mjs and shares one stylesheet (lib/css.mjs): the roster is spaces/network/code/index.html (project `network`, the space's door), a catalogue beside a field — the same fifty-two as a cloud in depth on the same paper, drawn on a 2D canvas by lib/field.client.js with no library at all, turning under a drag, lighting the row a point belongs to and the point a row belongs to; rooms are pages/<slug>.html via room-template.mjs's renderRoom(); the constellation is pages/constellation.html via renderConstellation(), the same fifty-two on one ring. A room's project id is network-<slug> because ids are global and two of the names are already wcc rooms. Nothing here loads three.js or any script at all except the roster's one field builder — the pages that did were a second design language for the same data, and they drifted from it. Team names as on /suite. No contact details on purpose. When a person takes their room over in Studio, remove their manifest from `projects`.",
  "tiers": {
    "prod": {
      "url": "https://di-studio.xyz/serverXR",
      "tokenEnv": "PROD_API_TOKEN"
    },
    "staging": {
      "url": "https://staging.di-studio.xyz/serverXR",
      "tokenEnv": "LIVE_API_TOKEN"
    },
    "local": {
      "url": "http://localhost:4000/serverXR",
      "tokenEnv": "API_TOKEN",
      "governed": false
    }
  },
