{
  "$schema": "https://di-studio.xyz/schemas/di-space.space.schema.json",
  "spaceId": "main",
  "label": "di.iiii",
  "isPublic": true,
  "minEngine": 6,
  "note": "The platform's own space — what di-studio.xyz opens on. The front room (main-dii-project) is authored in Studio and stays undeclared; the platform's own pages are declared below and pushed from this repo.",
  "tiers": {
    "prod": {
      "url": "https://di-studio.xyz/serverXR",
      "tokenEnv": "PROD_API_TOKEN"
    },
    "staging": {
      "url": "https://staging.di-studio.xyz/serverXR",
      "tokenEnv": "LIVE_API_TOKEN"
    },
    "local": {
      "url": "http://localhost:4000/serverXR",
      "tokenEnv": "API_TOKEN",
      "governed": false
    }
  },
  "projects": [
    "spaces/main/di-space.suite.json",
    "spaces/main/di-space.landing.json",
    "spaces/main/di-space.brand-guide.json"
  ]
}
