{$SITE_DOMAIN} {
	# Caddy issues the certificate but does not send HSTS on its own. A year
	# without preload: browsers that have visited once stop trying http://
	# first, and there is no subdomain claim that could strand a future host.
	header Strict-Transport-Security "max-age=31536000"
	# Container-internal port moved to 8080 (audit #27): the client
	# container now runs nginx as non-root, which can't bind below 1024.
	reverse_proxy client:8080
}

# The dev tier (identifier still `staging`): a separate low-resource Compose
# project on this same host (see docker-compose.staging.yml +
# docs/deploy/VPS_DOCKER_DEPLOY.md). STAGING_DOMAIN may list several names,
# comma-separated -- on the VPS it is `staging.di-studio.xyz, dev.diiii.xyz`:
# dev.diiii.xyz is the address we hand out, staging.di-studio.xyz the legacy
# name kept so links already given out still open.
# Inert until STAGING_DOMAIN is set in .env and its DNS record exists --
# with no DNS pointing at it, Caddy just logs a harmless cert-issuance
# failure for this one block; the SITE_DOMAIN block above is unaffected.
# Default lives in docker-compose.yml's environment: mapping, not here as
# a Caddyfile {$VAR:default} -- see the comment there for why.
{$STAGING_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy host.docker.internal:{$STAGING_PORT:8081}
}

# map.di-studio.xyz — a memorable door onto the map lane, not a second app.
# It reverse-proxies to the SAME prod client as {$SITE_DOMAIN} above, so
# every path, asset and API call resolves exactly as it does there — the
# map lane already sits behind ProtectedSurface (per-space sign-in), so this
# adds a name, not a hole in the wall. Inert until MAP_DOMAIN is set in .env
# and its DNS record exists, same as STAGING_DOMAIN above.
{$MAP_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy client:8080
}
