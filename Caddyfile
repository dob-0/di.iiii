# Global options. The only one is for a space on its own domain (the block
# at the end of this file): before Caddy asks Let's Encrypt for a certificate
# for a name it has never seen, it asks serverXR whether we serve that name,
# and goes ahead only on a 200. Without this, anyone could aim any name at us
# and spend our Let's Encrypt limits. Inert while no site block uses
# `tls { on_demand }` with a real address -- see CUSTOM_DOMAINS_SITE below.
#   https://caddyserver.com/docs/automatic-https#on-demand-tls
#   https://caddyserver.com/docs/caddyfile/options#on-demand-tls
{
	on_demand_tls {
		ask http://server:4000/serverXR/api/domain-check
	}
}

{$SITE_DOMAIN} {
	# Caddy issues the certificate but does not send HSTS on its own. A year
	# without preload: browsers that have visited once stop trying http://
	# first, and there is no subdomain claim that could strand a future host.
	header Strict-Transport-Security "max-age=31536000"
	# Container-internal port moved to 8080 (audit #27): the client
	# container now runs nginx as non-root, which can't bind below 1024.
	reverse_proxy client:8080
}

# The dev tier: a separate low-resource Compose project on this same host
# (see docker-compose.dev.yml + docs/deploy/VPS_DOCKER_DEPLOY.md). DEV_DOMAIN
# may list several names, comma-separated -- on the VPS it is `dev.diiii.xyz`.
# Inert until DEV_DOMAIN is set in .env and its DNS record exists --
# with no DNS pointing at it, Caddy just logs a harmless cert-issuance
# failure for this one block; the SITE_DOMAIN block above is unaffected.
# Default lives in docker-compose.yml's environment: mapping, not here as
# a Caddyfile {$VAR:default} -- see the comment there for why.
{$DEV_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy host.docker.internal:{$DEV_PORT:8081}
}

# map.di-studio.xyz — a memorable door onto the map lane, not a second app.
# It reverse-proxies to the SAME prod client as {$SITE_DOMAIN} above, so
# every path, asset and API call resolves exactly as it does there — the
# map lane already sits behind ProtectedSurface (per-space sign-in), so this
# adds a name, not a hole in the wall. Inert until MAP_DOMAIN is set in .env
# and its DNS record exists, same as DEV_DOMAIN above.
{$MAP_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy client:8080
}

# A space on its own domain, without Cloudflare (docs/architecture/
# SPEC_space_own_domain.md, "Without Cloudflare: Caddy on-demand TLS").
# Every hostname not named above lands here; Caddy gets its certificate the
# first time a visitor arrives, once the `ask` above says yes -- i.e. once
# serverXR (DOMAINS_PROVIDER=caddy) has seen the domain's DNS point at this
# host. The app then reads the host and shows that space.
# Inert by default: CUSTOM_DOMAINS_SITE defaults (in docker-compose.yml) to a
# name under .invalid that never resolves, and an on-demand site gets no
# certificate until a visitor arrives, so nothing is issued and nothing is
# logged. To switch it on, set CUSTOM_DOMAINS_SITE=https:// in .env and
# restart caddy. No HSTS here: that header would bind someone else's domain,
# which is the domain owner's decision, not ours.
{$CUSTOM_DOMAINS_SITE} {
	tls {
		on_demand
	}
	reverse_proxy client:8080
}
