# Node / build output
node_modules/
# ...and node_modules as a symlink (git worktrees commonly link it back to the
# main checkout). The trailing-slash pattern above matches directories only, so
# a symlink slipped through and got committed once.
node_modules
dist/
.vite/
.vite-cache/
.cache/
coverage/
tmp/
.archive/
.deploy/

# Env and local config
.env
.env.*.local
.env.local
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev-stack.log

# OS noise
.DS_Store

# Local workspace-only files
.codex
open_call/
scene examples/
.playwright-mcp/
/*.png
CLAUDE.local.md
**/CLAUDE.local.md
*.dii-project.zip
*.scene.zip
docs/checkpoints/
.cpanel.yml
scratchpad/
docs/ai/agent-handoff.md

# Server data
serverXR/data/
serverXR/uploads/
serverXR/.env
serverXR/.env.local
# and every hand-made backup of it. `.env.*.local` does not match
# `.env.local.before-shared-tier`, which sat here untracked and
# un-ignored with a live GITHUB_CLIENT_SECRET in it (found 2026-09-12).
serverXR/.env.local.*
# Local-only data roots for isolated worktrees (see serverXR/.env DATA_ROOT)
serverXR/.data-*

# verify-surfaces.mjs screenshots + report (local artefact)
.verify-surfaces/
# verify-capture.mjs screenshots (local artefact)
.verify-capture/

# Self-signed certs for `npm run dev:xr` (headset-reachable HTTPS). Machine-
# specific and regenerated on demand — never commit them.
.dev-certs/

# di runtime artifacts (built by `npm run di:pack`)
dist-runtime/

# generated page bundle — see spaces/the-light-put-back/README.md. Hand-written
# pages (spaces/network/code) are source and stay tracked.
spaces/the-light-put-back/code/index.html

# Generated Trusted Web Activity project for the studio chat APK
# (docs/deploy/STUDIO_CHAT_APK.md): a Gradle tree, a downloaded toolchain's
# output and signed artifacts, none of which belong in the repo. Its INPUT does
# — without twa-manifest.json the next APK is a guess at what this one was.
android-twa/*
!android-twa/twa-manifest.json
android-twa-staging/

# Claude Code's per-machine settings — local by definition
.claude/settings.local.json
