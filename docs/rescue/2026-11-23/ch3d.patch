+
+def flush(buf, ns):
+    global i
+    small = [cv2.resize(f, (540, 960), interpolation=cv2.INTER_AREA) for f in buf]
+    t = torch.from_numpy(np.stack([s[:, :, ::-1] for s in small])).permute(0, 3, 1, 2).float().div(255).cuda()
