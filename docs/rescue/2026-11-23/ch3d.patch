+            a, b = xv[j], xv[j + 1]
+            top = ok & (np.abs(th) <= 8) & (np.maximum(s[:, 0], s[:, 2]) <= b + 30) & (np.minimum(s[:, 0], s[:, 2]) >= a - 30) & (L >= 0.5 * (b - a))
+            if top.any(): opening = True; break
