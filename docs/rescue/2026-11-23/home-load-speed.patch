diff --git a/src/landing/landingEntryWeight.test.js b/src/landing/landingEntryWeight.test.js
new file mode 100644
index 000000000..be2d9bce4
--- /dev/null
+++ b/src/landing/landingEntryWeight.test.js
@@ -0,0 +1,57 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+// The front page's own chunk must not drag three.js in. Measured 2026-11-10
+// (Lighthouse mobile, built tree): LandingPage.jsx statically imported
+// PageDebris.jsx (react-three-fiber) and, through enterFlight.js, pagePieces.js
+// (three), so 512 KB gzip of three-vendor rode along with every visit, in front
+// of the wordmark: LCP 6.9 s, TBT 349 ms. Both are now fetched by import() when
+// the room is wanted. This walks the STATIC import graph of the page, so the
+// next innocent `import X from './SomethingWith3D.jsx'` goes red here, not on
+// somebody's phone.
+const here = path.dirname(fileURLToPath(import.meta.url))
+const IMPORT = /^\s*(?:import|export)\s[^'"]*?from\s*['"]([^'"]+)['"]|^\s*import\s*['"]([^'"]+)['"]/gm
+const resolveFile = (from, spec) => {
+    const base = path.resolve(path.dirname(from), spec)
+    return [base, `${base}.js`, `${base}.jsx`, `${base}/index.js`, `${base}/index.jsx`].find((f) => fs.existsSync(f) && fs.statSync(f).isFile())
+}
+const staticGraph = (entry) => {
+    const seen = new Set()
+    const bare = new Set()
+    const walk = (file) => {
+        if (seen.has(file)) return
+        seen.add(file)
+        const source = fs.readFileSync(file, 'utf8')
+        for (const m of source.matchAll(IMPORT)) {
+            const spec = m[1] || m[2]
+            if (spec.startsWith('.')) {
+                const next = resolveFile(file, spec)
+                if (next && /\.jsx?$/.test(next)) walk(next)
+            } else bare.add(spec)
+        }
+    }
+    walk(entry)
+    return { files: [...seen].map((f) => path.relative(path.resolve(here, '..'), f)), bare: [...bare] }
+}
+
+describe('the front page entry weight', () => {
+    const { files, bare } = staticGraph(path.join(here, 'LandingPage.jsx'))
+
+    it('does not statically reach three.js or react-three-fiber', () => {
+        const threeBound = bare.filter((s) => s === 'three' || s.startsWith('three/') || s.startsWith('@react-three/') || s.startsWith('three-'))
+        expect(threeBound, `static imports: ${files.join(', ')}`).toEqual([])
+    })
+
+    it('does not statically import the door flight or the falling page', () => {
+        for (const heavy of ['landing/enterFlight.js', 'landing/PageDebris.jsx', 'landing/pagePieces.js']) {
+            expect(files).not.toContain(heavy)
+        }
+    })
+
+    it('keeps pdf.js out of the shared vendor chunk (its own pdfjs-vendor)', () => {
+        const config = fs.readFileSync(path.resolve(here, '../../vite.config.js'), 'utf8')
+        expect(config).toMatch(/pkg === 'pdfjs-dist'\) return 'pdfjs-vendor'/)
+    })
+})
