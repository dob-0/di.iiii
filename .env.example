# ── Docker / Node setup ────────────────────────────────────────────────────────
# Copy this file to .env and fill in values before running:
#   cp .env.example .env && docker compose up -d

# Port the app is accessible on the host.
# Use 80 on a root server or Docker Desktop. Use 8080+ on rootless Linux (Podman).
PORT=8080

# ── Auth ───────────────────────────────────────────────────────────────────────
# Defaults to true (docker-compose.yml always sets NODE_ENV=production).
# Set REQUIRE_AUTH=false only for a deliberately open instance.
# Generate strong random strings: openssl rand -hex 32
REQUIRE_AUTH=true
ADMIN_API_TOKEN=
AUTH_SESSION_SECRET=

# Set to true when serving over HTTPS (recommended in production)
AUTH_SESSION_COOKIE_SECURE=true

# ── OAuth sign-in (optional) ────────────────────────────────────────────────────
# Google: create app at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
# GitHub: create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Base URL used to build both providers' callback URLs (no trailing slash)
OAUTH_CALLBACK_BASE_URL=

# ── GitHub App: repo→space sync (optional) ─────────────────────────────────────
# A GitHub *App*, not the OAuth App above: https://github.com/settings/apps
# Without all three, one-click GitHub sync reports "not configured" and the
# push webhook is rejected — silently, by design. Rotation: docs/ops/ROTATE_GITHUB_APP_SECRETS.md
GITHUB_APP_ID=
# base64 -w0 <app>.private-key.pem   (avoids keeping a .pem on the host)
GITHUB_APP_PRIVATE_KEY_B64=
# openssl rand -hex 32 — must equal the App's webhook secret in its settings
GITHUB_APP_WEBHOOK_SECRET=

# ── Uploads ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=100

# ── CORS ───────────────────────────────────────────────────────────────────────
# Leave empty when client and server share the same nginx origin (default Docker setup).
# Set to a comma-separated list of allowed origins if using a separate API host.
CORS_ORIGINS=

# ── Frontend API base URL ──────────────────────────────────────────────────────
# Leave empty in the default Docker setup — nginx proxies /serverXR/* automatically.
# Set to an absolute URL only if client and server are on different origins.
VITE_API_BASE_URL=

# ── Cloudflare Tunnel (optional) ───────────────────────────────────────────────
# Leave empty to use a free random *.trycloudflare.com URL (no account needed).
# Set to your named tunnel token for a fixed domain (from Cloudflare dashboard).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Direct HTTPS via Caddy (optional, profile: https) ─────────────────────────
# Alternative to the Cloudflare Tunnel: point a DNS A/AAAA record at this
# host's IP, set the domain below, set PORT above to something other than 80,
# then run `docker compose --profile https up -d`. Caddy gets and renews a
# real Let's Encrypt cert automatically -- no Cloudflare account needed.
SITE_DOMAIN=

# ── Production image registry ──────────────────────────────────────────────────
# Used by docker-compose.prod.yml — set to your GitHub username or org.
REGISTRY_USER=youruser
IMAGE_TAG=latest

# ── Staging (docker-compose.staging.yml) ───────────────────────────────────────
# These only apply in the SEPARATE staging checkout directory's .env — see
# docs/deploy/VPS_DOCKER_DEPLOY.md. Keep them out of the production .env so
# the two environments never share a session-signing secret.
# Host port staging's client is published on; production's Caddy (in the
# other checkout) reverse-proxies STAGING_DOMAIN to this port.
STAGING_PORT=8081
# Subdomain pointing at this same host, e.g. staging.your-domain — set here
# AND in the production checkout's .env (Caddy reads it there).
STAGING_DOMAIN=
STAGING_REQUIRE_AUTH=true
STAGING_ADMIN_API_TOKEN=
# Generate with: openssl rand -hex 32 — must differ from AUTH_SESSION_SECRET
STAGING_AUTH_SESSION_SECRET=
STAGING_AUTH_SESSION_COOKIE_SECURE=true
STAGING_CORS_ORIGINS=
STAGING_GOOGLE_CLIENT_ID=
STAGING_GOOGLE_CLIENT_SECRET=
STAGING_GOOGLE_API_KEY=
STAGING_GITHUB_CLIENT_ID=
STAGING_GITHUB_CLIENT_SECRET=
STAGING_GITHUB_APP_ID=
STAGING_GITHUB_APP_PRIVATE_KEY_B64=
STAGING_GITHUB_APP_WEBHOOK_SECRET=
STAGING_OAUTH_CALLBACK_BASE_URL=

# ── Local dev only ─────────────────────────────────────────────────────────────
# Uncomment for local non-Docker dev where serverXR runs on a separate port:
# VITE_API_BASE_URL=http://localhost:4000

# ── Space sync (space:pull / space:push scripts) ───────────────────────────────
# Copy to .env.local and fill in — never commit .env.local
# Live server base URL (with serverXR path prefix):
LIVE_API_URL=https://di-studio.xyz/serverXR
# Local server base URL:
LOCAL_API_URL=http://localhost:4000/serverXR
# Auth token for writing to the live server (editor or admin role):
# Generate with: openssl rand -hex 32 — must match EDITOR_API_TOKEN or ADMIN_API_TOKEN on the live server
LIVE_API_TOKEN=
