# Dev-tier Node.js runtime (cPanel identifier: staging)
NODE_ENV=production

# Dev-tier port
PORT=4000

# Public base path
APP_BASE_PATH=/serverXR

# Keep dev-tier data separate from production
DATA_ROOT=/home/your-user/serverXR-staging/data
SHARED_ROOT=/home/your-user/shared

# Auth off on the dev tier — open access for testing
REQUIRE_AUTH=false
API_TOKEN=change-me

# Allow your dev-tier frontend origin
CORS_ORIGINS=https://dev.your-domain

# Upload size cap in MB
MAX_UPLOAD_MB=100
